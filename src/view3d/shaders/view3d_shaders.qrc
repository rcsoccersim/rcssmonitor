<!DOCTYPE RCC>
<RCC version="1.0">
  <!-- The shaders of the 3D view, compiled into the program as Qt's
       resources and loaded by ShaderProgram::load() as :/shaders/<file>.
       A new shader file must be listed here. -->
  <qresource prefix="/shaders">
    <file>ground.vert</file>
    <file>ground.frag</file>
    <file>lit.vert</file>
    <file>lit.frag</file>
    <file>flat.vert</file>
    <file>flat.frag</file>
    <file>billboard.vert</file>
    <file>billboard.frag</file>
    <file>colored.vert</file>
    <file>colored.frag</file>
    <file>panel.vert</file>
    <file>panel.frag</file>
    <file>skinned.vert</file>
    <file>skinned.frag</file>
    <file>depth.vert</file>
    <file>depth.frag</file>
    <file>shadow.vert</file>
    <file>shadow.frag</file>
    <file>blob.vert</file>
    <file>blob.frag</file>
    <file>sky.vert</file>
    <file>sky.frag</file>
    <file>outside.vert</file>
    <file>outside.frag</file>
  </qresource>
</RCC>
