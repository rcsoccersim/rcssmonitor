if HAVE_QT_MULTIMEDIA
# the referee's whistle: the sounds (tools/make_whistle.py) in the resources
nodist_rcssmonitor_SOURCES += qrc_sounds.cpp
endif

qrc_sounds.cpp: $(top_srcdir)/resources/sounds/sounds.qrc $(top_srcdir)/resources/sounds/whistle_short.wav $(top_srcdir)/resources/sounds/whistle_long.wav
	$(QT_RCC) --name sounds --output $@ $(top_srcdir)/resources/sounds/sounds.qrc

if HAVE_QT_WEBSOCKETS
rcssmonitor_SOURCES += ws_monitor_transport.cpp
nodist_rcssmonitor_SOURCES += moc_ws_monitor_transport.cpp
endif


rcssmonitor_CPPFLAGS = -I$(top_srcdir) -I$(top_srcdir)/src $(QT_CPPFLAGS)
rcssmonitor_CXXFLAGS =  $(QT_CXXFLAGS) -W -Wall
rcssmonitor_LDFLAGS = $(QT_LDFLAGS)
# librcssrcg by its libtool library: libtool puts the path of the installed
# library (libdir) in the installed program (RPATH), so that it starts
# without LD_LIBRARY_PATH also from a prefix such as ~/.local
rcssmonitor_LDADD = $(top_builddir)/rcss/rcg/librcssrcg.la $(QT_LIBS) $(LIBDEFLATE_LIBS)

# source files from headers generated by Meta Object Compiler
moc_%.cpp: %.h
	$(QT_MOC) $< -o $@

# the icons embedded with the Qt resource system (icons/generate.sh; UIIcon).
# icons.am defines the lists of the files (ICONS_SVG_FILES, ICONS_PNG_FILES).
ICONS_DIR = $(top_srcdir)/icons
include $(top_srcdir)/icons/icons.am

qrc_icons.cpp: $(ICONS_DIR)/icons.qrc $(ICONS_PNG_FILES)
	$(QT_RCC) --name icons --output $@ $(ICONS_DIR)/icons.qrc

