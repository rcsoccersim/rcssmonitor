# The desktop entry of rcssmonitor (freedesktop.org Desktop Entry).
# It is installed as PREFIX/share/applications/rcssmonitor.desktop, and the
# placeholder of the directory of the executable in TryExec and Exec is
# replaced with PREFIX/bin at the installation (CMakeLists.txt), so that the
# entry starts it even if PREFIX/bin (e.g. ~/.local/bin) is not in PATH.
[Desktop Entry]
Type=Application
Name=rcssmonitor
Comment=Monitor for the RoboCup Soccer Simulator
TryExec=@RCSSMONITOR_BINDIR@/rcssmonitor
Exec="@RCSSMONITOR_BINDIR@/rcssmonitor"
Icon=rcssmonitor
Terminal=false
Categories=Development;
